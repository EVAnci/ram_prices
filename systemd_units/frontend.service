[Unit]
Description=PC Scraper Frontend & API (FastAPI + uPlot)
After=network-online.target
Wants=network-online.target

StartLimitBurst=20

[Service]
Type=simple
User=valen
WorkingDirectory=/home/valen/scraper/frontend
EnvironmentFile=/home/valen/scraper/env.conf
ExecStart=/home/valen/scraper/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
RestartSec=10
TimeoutStartSec=10min
MemoryMax=300M

[Install]
WantedBy=multi-user.target
